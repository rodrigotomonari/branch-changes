{
  "name": "branch-changes",
  "displayName": "branch-changes",
  "description": "See all the file diffs between the current branch and a selected branch.",
  "author": {
    "name": "Rodrigo Tomonari"
  },
  "version": "0.0.1",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitChanges",
          "title": "Git Changes",
          "icon": "resources/git.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "gitChangedFilesView",
          "name": "Changed Files",
          "icon": "resources/git.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "gitChangedFiles.refresh",
        "title": "Refresh Changed Files"
      },
      {
        "command": "branch-changes.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "gitChangedFiles.selectBranch",
        "title": "Select Comparison Branch",
        "icon": "$(git-branch)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitChangedFiles.selectBranch",
          "when": "view == gitChangedFilesView",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.98.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3"
  }
}
